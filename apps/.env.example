# infra/apps/.env.example -> preparar .env sin sobrescribir valores existentes.
# Solo placeholders: reemplazar antes de arrancar.

# ===== RabbitMQ local existente =====
# Usar nombres/puertos internos desde una red Docker compartida, no los puertos del host.
RABBITMQ_ADDRESSES=rabbitmq1:5672,rabbitmq2:5672
RABBITMQ_NETWORK_NAME=digitalfix-messaging
# Usuario exclusivo por servicio. Nunca usar el admin del broker.
WORKORDERS_RABBITMQ_USERNAME=digitalfix_workorders
WORKORDERS_RABBITMQ_PASSWORD=CAMBIAR_WORKORDERS
NOTIFY_RABBITMQ_USERNAME=digitalfix_notify
NOTIFY_RABBITMQ_PASSWORD=CAMBIAR_NOTIFY
REPORT_RABBITMQ_USERNAME=digitalfix_report
REPORT_RABBITMQ_PASSWORD=CAMBIAR_REPORT
ADMIN_RABBITMQ_USERNAME=digitalfix_rabbit_admin
ADMIN_RABBITMQ_PASSWORD=CAMBIAR_RABBIT_ADMIN

# ===== Kafka: red del Compose Kafka; ajustar si se utilizó otro nombre de proyecto =====
KAFKA_NETWORK_NAME=kafka_kafkanet
KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092
KAFKA_REINTENTOS=3
KAFKA_ESPERA_REINTENTO=1s

# ===== Oracle (configuración ilustrativa; no iniciar contra RDS como prueba) =====
# Aplicar migraciones autorizadas antes de arrancar. update solo para una base local desechable.
JPA_DDL_AUTO=validate
DB_URL=jdbc:oracle:thin:@//oracle.example.invalid:1521/SERVICIO
DB_USERNAME=usuario_oracle
DB_PASSWORD=CAMBIAR_ORACLE
AUDIT_DB_URL=jdbc:oracle:thin:@//oracle.example.invalid:1521/SERVICIO
AUDIT_DB_USERNAME=usuario_audit
AUDIT_DB_PASSWORD=CAMBIAR_AUDIT

# ===== Emisor y audiencia; valores ilustrativos, no son secretos =====
ENTRA_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
ENTRA_AUDIENCE=API_CLIENT_ID

# ===== SMTP (notify) =====
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=CAMBIAR_SMTP
SMTP_PASSWORD=CAMBIAR_SMTP
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=remitente@example.invalid

# ===== Volúmenes existentes (PDFs e idempotencia) =====
NOTIFY_VOLUME_NAME=digitalfix-notify_notify-data
REPORT_VOLUME_NAME=digitalfix-report_report-data
