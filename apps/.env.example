# Conexión común a Oracle RDS
DB_URL=jdbc:oracle:thin:@//TU_ENDPOINT_RDS:1521/DIGITALF

# Credenciales compartidas por Catalog y Workorders en el despliegue actual.
DB_USERNAME=usuario_oracle
DB_PASSWORD='TU_PASSWORD_ORACLE'

# Credenciales ilustrativas: reemplazar antes de arrancar. Nunca usar el admin del broker.
WORKORDERS_RABBITMQ_USERNAME=digitalfix_workorders
WORKORDERS_RABBITMQ_PASSWORD=CAMBIAR_WORKORDERS
NOTIFY_RABBITMQ_USERNAME=digitalfix_notify
NOTIFY_RABBITMQ_PASSWORD=CAMBIAR_NOTIFY
REPORT_RABBITMQ_USERNAME=digitalfix_report
REPORT_RABBITMQ_PASSWORD=CAMBIAR_REPORT
ADMIN_RABBITMQ_USERNAME=digitalfix_rabbit_admin
ADMIN_RABBITMQ_PASSWORD=CAMBIAR_RABBIT_ADMIN

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=CAMBIAR_SMTP
SMTP_PASSWORD=CAMBIAR_SMTP
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=remitente@example.invalid

# Deben coincidir con la API registrada en Entra; no cambiar issuer/audience del BFF.
ENTRA_ISSUER=https://login.microsoftonline.com/762b016c-dc33-4db0-ad42-44f32afe71f4/v2.0
ENTRA_AUDIENCE=85329d90-58f8-4317-a820-452599b3b04c

# Reutilizar los nombres inspeccionados en el host, incluidos PDF e idempotencia.
NOTIFY_VOLUME_NAME=digitalfix-notify_notify-data
REPORT_VOLUME_NAME=digitalfix-report_report-data
