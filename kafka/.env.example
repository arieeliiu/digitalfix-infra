# Clientes Java fuera de Docker usan los listeners externos anunciados aquí.
KAFKA_HOST=localhost
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_PORT1=9092
KAFKA_PORT2=9093
KAFKA_PORT3=9094
KAFKA_UI_PORT=8090

# Clientes en la red Docker del clúster: kafka1:29092,kafka2:29092,kafka3:29092.
# Para otro host, configurar host anunciado/bind y red privada; no publicar Kafka UI en Internet.
